    freeaddrinfo=C:\Windows\System32\ws2_32.freeaddrinfo
    gethostname=C:\Windows\System32\ws2_32.gethostname
    socket=C:\Windows\System32\ws2_32.socket
    closesocket=C:\Windows\System32\ws2_32.closesocket
    bind=C:\Windows\System32\ws2_32.bind
    connect=C:\Windows\System32\ws2_32.connect
