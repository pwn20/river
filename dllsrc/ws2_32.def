    recv=C:\Windows\System32\ws2_32.recv
    select=C:\Windows\System32\ws2_32.select
    ioctlsocket=C:\Windows\System32\ws2_32.ioctlsocket
    setsockopt=C:\Windows\System32\ws2_32.setsockopt
